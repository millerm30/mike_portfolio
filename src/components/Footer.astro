---
import Icon from "./Icon.astro";
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="group">
    <p class="brand">Michael Miller</p>
    <p>Designed & developed in Newfoundland with <a href="https://astro.build/">Astro</a>
      <Icon icon="rocket-launch" size="1.1em" />
    </p>
    <p>&copy; {currentYear}</p>
  </div>
  <p class="socials">
    <a href="https://www.linkedin.com/in/michael-miller-0aa2bb229" target="_blank">LinkedIn</a>
    <a href="https://www.github.com/millerm30" target="_blank">GitHub</a>
    <a href="mailto:millergm30@gmail.com">Email</a>
  </p>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: auto;
    padding: 3rem 1.5rem 2.5rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .brand {
    font-family: var(--font-brand);
    font-weight: 700;
    color: var(--gray-0);
    letter-spacing: -0.03em;
  }

  footer a {
    color: var(--gray-200);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition), color var(--theme-transition);
  }

  footer a:hover,
  footer a:focus {
    color: var(--gray-0);
    text-decoration-color: currentColor;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: end;
      padding: 3rem 5rem 2.75rem;
      text-align: left;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
