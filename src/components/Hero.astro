---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	kicker?: string;
}

const { align = 'center', tagline, title, kicker } = Astro.props;
---

<div class:list={['hero stack gap-4', align]} data-reveal>
	{kicker && <p class="kicker">{kicker}</p>}
	<div class="stack gap-2">
		<h1 class="title">{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline {
		max-width: 22ch;
		margin-inline: auto;
	}

	.title {
		font-size: clamp(2.4rem, 6vw, 4.75rem);
		color: var(--gray-0);
	}

	.tagline {
		max-width: 42ch;
		color: var(--gray-300);
		font-weight: 400;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline,
		.start .kicker {
			margin-inline: unset;
		}

		.title {
			max-width: 18ch;
		}
	}
</style>
