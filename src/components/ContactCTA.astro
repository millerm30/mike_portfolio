---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside data-reveal>
	<div class="copy">
		<p class="kicker">Next conversation</p>
		<h2>Have something worth building?</h2>
		<p>I like hard product problems, clean APIs, and shipping with people who care about the details.</p>
	</div>
	<CallToAction href="mailto:millergm30@gmail.com">
		Send Me a Message
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		margin-inline: 1.25rem;
		padding: 3.5rem 1.5rem;
		border-radius: 1.75rem;
		border: 1px solid var(--glass-border);
		background: var(--surface);
		box-shadow: var(--shadow-md);
		text-align: center;
	}

	aside::before {
		content: '';
		position: absolute;
		inset: -40% auto auto 20%;
		width: 22rem;
		height: 22rem;
		background: radial-gradient(circle, var(--glow-violet), transparent 70%);
		pointer-events: none;
	}

	.copy {
		display: grid;
		gap: 0.7rem;
		position: relative;
		justify-items: center;
	}

	h2 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		max-width: 16ch;
	}

	.copy p:last-child {
		max-width: 42ch;
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		aside {
			margin-inline: auto;
			max-width: 83rem;
			width: calc(100% - 5rem);
			padding: 4.5rem 3.5rem;
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}

		.copy {
			justify-items: start;
		}
	}
</style>
