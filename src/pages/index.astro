---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

let projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const slugsToRemove = ["todo-trello", "platecove-design", "chore-bucks"];

projects = projects.filter((project) => !slugsToRemove.includes(project.slug));

const mentions = [
  {
    name: "mentionOne",
    image: "/assets/mention_one.png",
    userName: "Laura Tannahill",
    userInfo: "Software Developer @ TELUS Digital",
  },
  {
    name: "mentionTwo",
    image: "/assets/mention_two.png",
    userName: "Sahand Seifi",
    userInfo: "CTO @ Get Coding & CEO @ Pingram",
  },
  {
    name: "mentionThree",
    image: "/assets/mention_three.png",
    userName: "Moustafa Elsisy",
    userInfo: "Staff Software Developer @ Nasdaq",
  },
  {
    name: "mentionFour",
    image: "/assets/mention_four.png",
    userName: "Cory Loughran",
    userInfo: "Software Developer @ Dash Hudson",
  },
  {
    name: "mentionFive",
    image: "/assets/mention_five.png",
    userName: "Peter Woodman",
    userInfo: "Principal Software Architect @ Mysa",
  },
];
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-30">
    <div class="wrapper stack gap-15">
      <header class="hero">
        <div class="hero-copy" data-reveal>
          <p class="kicker">
            <span class="live-dot"></span>
            Building at Pingram · Newfoundland
          </p>
          <h1>
            I ship the products
            <span class="text-gradient">developers build on.</span>
          </h1>
          <p class="lede">
            Full-stack software developer working across React, TypeScript, and
            AWS — from dashboard to delivery pipeline.
          </p>
          <div class="hero-actions">
            <CallToAction href="/work/">
              See the work
              <Icon icon="arrow-right" size="1.1em" />
            </CallToAction>
            <a class="ghost" href="mailto:millergm30@gmail.com">
              Get in touch
              <Icon icon="paper-plane-tilt" size="1.05em" />
            </a>
          </div>
          <div class="roles">
            <Pill><Icon icon="code" size="1.2em" /> Full-Stack Developer</Pill>
            <Pill><Icon icon="terminal-window" size="1.2em" /> Cloud & APIs</Pill>
          </div>
        </div>

        <div class="hero-visual" data-reveal="right">
          <div class="photo-orbit" aria-hidden="true"></div>
          <figure class="photo-frame">
            <img
              alt="Michael Miller profile photo"
              width="480"
              height="480"
              src="/assets/michael_miller.png"
            />
          </figure>
        </div>
      </header>

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-30">
      <section class="section">
        <header class="section-header stack gap-2 lg:gap-4" data-reveal>
          <p class="kicker">Selected work</p>
          <h3>Shipped products, not just demos.</h3>
          <p>
            Real platforms and tools — dashboards, APIs, SDKs, and the
            infrastructure that keeps them moving.
          </p>
        </header>

        <div class="shipped">
          {
            projects.map((project, index) => (
              <a
                class:list={["featured", { flip: index % 2 === 1 }]}
                href={`/work/${project.slug}`}
                data-reveal
              >
                <img
                  src={project.data.img}
                  alt={project.data.img_alt || project.data.title}
                />
                <div class="featured-copy">
                  <h4>{project.data.title}</h4>
                  <p>{project.data.description}</p>
                  <div class="featured-tags">
                    {project.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <span class="featured-link">
                    Read the case
                    <Icon icon="arrow-right" size="1em" />
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="cta" data-reveal>
          <CallToAction href="/work/">
            View all work
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="section">
        <header class="section-header stack gap-2 lg:gap-4" data-reveal>
          <p class="kicker">Signal from the people I work with</p>
          <h3>User Feedback</h3>
          <p>
            Slack notes from teammates and collaborators — the kind you get
            when the work actually lands.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="small">
            {
              mentions.map((brand) => (
                <li class="mention-card" data-reveal>
                  <div class="mention-meta">
                    <p class="mention-name">{brand.userName}</p>
                    <p class="mention-role">{brand.userInfo}</p>
                  </div>
                  <img src={brand.image} alt={`Message from ${brand.userName}`} />
                </li>
              ))
            }
          </Grid>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding-top: 1rem;
  }

  .hero-copy {
    display: grid;
    gap: 1.35rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 8vw, 5.4rem);
    max-width: 14ch;
    margin-inline: auto;
  }

  .hero h1 span {
    display: block;
  }

  .lede {
    max-width: 38ch;
    margin-inline: auto;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85em 1.4em;
    border-radius: 999px;
    text-decoration: none;
    color: var(--gray-0);
    border: 1px solid var(--glass-border);
    background: var(--surface);
    font-family: var(--font-brand);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .ghost:hover,
  .ghost:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent-bright) 50%, var(--glass-border));
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .hero-visual {
    position: relative;
    width: min(22rem, 80vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .photo-orbit {
    position: absolute;
    inset: -8%;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg,
      var(--accent-regular),
      var(--accent-secondary),
      #f472b6,
      var(--accent-regular)
    );
    filter: blur(0.5px);
    opacity: 0.85;
    mask: radial-gradient(farthest-side, transparent calc(100% - 8px), #000 calc(100% - 7px));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 8px), #000 calc(100% - 7px));
  }

  .photo-frame {
    position: relative;
    width: 86%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 60px var(--glow-violet);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .section {
    display: grid;
    gap: 2rem;
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 46ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  .section-header h3 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .featured {
    display: grid;
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid var(--glass-border);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-md);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .featured:hover,
  .featured:focus-visible {
    transform: translateY(-8px);
    box-shadow: var(--shadow-glow);
  }

  .featured img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    object-position: top;
  }

  .featured-copy {
    display: grid;
    gap: 0.7rem;
    padding: 1.4rem 1.35rem 1.5rem;
  }

  .featured-copy h4 {
    font-size: var(--text-2xl);
  }

  .featured-copy p {
    color: var(--gray-300);
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .featured-tags span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    color: var(--gray-100);
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-bright);
    font-family: var(--font-brand);
    font-weight: 700;
  }

  .shipped {
    display: grid;
    gap: 1.25rem;
  }

  .cta {
    justify-self: center;
  }

  .mention-card {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border-radius: 1.25rem;
    border: 1px solid var(--glass-border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .mention-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow);
  }

  .mention-name {
    font-family: var(--font-brand);
    font-weight: 700;
    color: var(--gray-0);
  }

  .mention-role {
    font-size: var(--text-sm);
    color: var(--gray-400);
  }

  .mention-card img {
    width: 100%;
    border-radius: 0.9rem;
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3rem;
      min-height: min(78vh, 46rem);
      padding-inline: 0.5rem;
    }

    .hero-copy {
      text-align: start;
      justify-items: start;
    }

    .hero h1,
    .lede {
      margin-inline: unset;
    }

    .hero-actions,
    .roles {
      justify-content: flex-start;
    }

    .lede {
      font-size: var(--text-lg);
    }

    .hero-visual {
      width: min(28rem, 100%);
      justify-self: end;
    }

    .section {
      gap: 2.5rem;
    }

    .section-header {
      justify-self: start;
      text-align: left;
      max-width: 42ch;
    }

    .featured {
      grid-template-columns: 1.35fr 1fr;
      min-height: 22rem;
    }

    .featured.flip {
      grid-template-columns: 1fr 1.35fr;
    }

    .featured.flip img {
      order: 2;
    }

    .featured img {
      height: 100%;
    }

    .featured-copy {
      align-content: center;
      padding: 2rem;
    }

    .cta {
      justify-self: start;
    }
  }
</style>
